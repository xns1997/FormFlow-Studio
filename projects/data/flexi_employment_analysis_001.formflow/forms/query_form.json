    {
      "id": "query_btn",
      "type": "button",
      "x": 16,
      "y": 200,
      "width": 120,
      "height": 40,
      "zIndex": 2,
      "props": {
        "label": "执行查询",
        "events": {
          "onClick": "async function executeQuery() {\n  // 获取表单字段值\n  const year = formValues['年份'] ? Number(formValues['年份']) : null;\n  const province = formValues['query_province'] || null;\n  const workCategory = formValues['query_work_category'] || null;\n  const workType = formValues['query_work_type'] || null;\n  const incomeMin = formValues['query_income_min'] ? Number(formValues['query_income_min']) : null;\n  const incomeMax = formValues['query_max_income'] ? Number(formValues['query_max_income']) : null;\n  \n  // 从数据源读取数据\n  const dataSource = await getDataSource('flexi_employment_stats');\n  const allData = await dataSource.getRows('Sheet1');\n  \n  // 过滤数据\n  let filteredData = allData;\n  \n  if (year !== null && !isNaN(year)) {\n    filteredData = filteredData.filter(row => row['年份'] === year);\n  }\n  \n  if (province !== null && province !== '') {\n    filteredData = filteredData.filter(row => row['省份'] === province);\n  }\n  \n  if (workCategory !== null && workCategory !== '') {\n    filteredData = filteredData.filter(row => row['工种大类'] === workCategory);\n  }\n  \n  if (workType !== null && workType !== '') {\n    filteredData = filteredData.filter(row => row['细分工种'] === workType);\n  }\n  \n  if (incomeMin !== null && !isNaN(incomeMin)) {\n    filteredData = filteredData.filter(row => {\n      const income = Number(row['平均月收入']);\n      return !isNaN(income) && income >= incomeMin;\n    });\n  }\n  \n  if (incomeMax !== null && !isNaN(incomeMax)) {\n    filteredData = filteredData.filter(row => {\n      const income = Number(row['平均月收入']);\n      return !isNaN(income) && income <= incomeMax;\n    });\n  }\n  \n  // 将过滤后的数据更新到结果表格\n  setComponentProps('query_result_table', { rows: filteredData });\n  \n  // 返回查询结果数量\n  return { queryResultCount: filteredData.length };\n}\n\nreturn await executeQuery();"
        }
      }
    },
