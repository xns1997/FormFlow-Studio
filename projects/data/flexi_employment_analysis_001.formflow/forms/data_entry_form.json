  "formWindow": {
    "x": 40,
    "y": 20,
    "width": 900,
    "height": 1060,
    "props": {
      "title": "灵活就业数据录入表单",
      "subtitle": "",
      "background": "#ffffff",
      "padding": 24,
      "borderRadius": 12,
      "submitText": "提交",
      "resetText": "重置",
      "showFooter": true,
      "onSubmit": "const year = formValues['年份']; const province = formValues['省份']; const workType = formValues['细分工种']; if (!year || !province || !workType) { return { valid: false, errors: [{ field: '细分工种', message: '年份、省份和细分工种为必填项' }] }; } const malePct = parseFloat(formValues['男性占比']) || 0; const femalePct = parseFloat(formValues['女性占比']) || 0; const otherPct = parseFloat(formValues['其他占比']) || 0; const total = malePct + femalePct + otherPct; if (Math.abs(total - 100) > 0.01) { return { valid: false, errors: [{ field: '女性占比', message: '性别占比之和必须等于100%，当前为' + total.toFixed(1) + '%' }] }; } const employees = parseFloat(formValues['从业人数']); if (employees !== null && employees !== undefined && !isNaN(employees) && employees < 0) { return { valid: false, errors: [{ field: '从业人数', message: '从业人数不能为负数' }] }; } const income = parseFloat(formValues['平均月收入']); if (income !== null && income !== undefined && !isNaN(income) && income < 0) { return { valid: false, errors: [{ field: '平均月收入', message: '平均月收入不能为负数' }] }; } const growth = parseFloat(formValues['同比增长率']); if (growth !== null && growth !== undefined && !isNaN(growth) && growth < -100) { return { valid: false, errors: [{ field: '同比增长率', message: '同比增长率不能低于-100%' }] }; } return { valid: true, errors: [] }; "
    }
  }
