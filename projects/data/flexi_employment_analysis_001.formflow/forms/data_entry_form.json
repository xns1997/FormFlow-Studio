        "events": {
          "onChange": "// 实时校验性别占比之和是否等于100%\nconst malePct = parseFloat(formValues['男性占比']) || 0;\nconst femalePct = parseFloat(formValues['女性占比']) || 0;\nconst otherPct = parseFloat(formValues['其他占比']) || 0;\nconst total = malePct + femalePct + otherPct;\nif (Math.abs(total - 100) > 0.01) {\n  return { valid: false, message: '男性占比与女性占比之和必须等于100%，当前为' + total.toFixed(1) + '%' };\n}\nreturn { valid: true };"
