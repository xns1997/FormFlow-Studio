      "description": "触发信号"
    },
    {
      "name": "items",
      "type": "array",
      "required": false,
      "description": "要遍历的数组"
    },
    {
      "name": "data",
      "type": "any",
      "required": false,
      "description": "数据输入：data"
    }
  ],
  "outputs": [
    {
      "name": "each",
      "type": "trigger",
      "description": "每次迭代触发"
