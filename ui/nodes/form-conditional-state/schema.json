{
  "id": "form:conditional-state",
  "label": "条件字段状态",
  "description": "按一个条件统一控制字段的显隐、禁用或必填状态",
  "category": "高阶 · 表单",
  "kind": "generic",
  "macro": {
    "version": 1,
    "expansion": "runtime-composite",
    "debugMapping": "node-output",
    "snapshot": []
  },
  "properties": [
    {
      "name": "field",
      "label": "条件字段",
      "type": "string",
      "default": ""
    },
    {
      "name": "operator",
      "label": "比较方式",
      "type": "enum",
      "enum": [
        "==",
        "!=",
        ">",
        ">=",
        "<",
        "<=",
        "contains",
        "isEmpty",
        "isNotEmpty"
      ],
      "default": "=="
    },
    {
      "name": "compareValue",
      "label": "比较值",
      "type": "string",
      "default": ""
    },
    {
      "name": "target",
      "label": "目标字段/组件",
      "type": "string",
      "default": ""
    },
    {
      "name": "state",
      "label": "状态",
      "type": "enum",
      "enum": [
        "visible",
        "disabled",
        "required"
      ],
      "default": "visible"
    },
    {
      "name": "whenTrue",
      "label": "命中时开启",
      "type": "boolean",
      "default": true
    },
    {
      "name": "clearWhenInactive",
      "label": "状态关闭时清空",
      "type": "boolean",
      "default": false
    }
  ],
  "ports": [
    {
      "name": "formData",
      "label": "表单数据",
      "type": "object",
      "direction": "input",
      "description": "表单数据对象"
    },
    {
      "name": "value",
      "label": "条件值",
      "type": "any",
      "direction": "input",
      "description": "值"
    },
    {
      "name": "matched",
      "label": "条件命中",
      "type": "boolean",
      "direction": "output",
      "description": "是否命中"
    },
    {
      "name": "active",
      "label": "最终状态",
      "type": "boolean",
      "direction": "output",
      "description": "是否激活"
    },
    {
      "name": "compareValue",
      "label": "compareValue",
      "type": "any",
      "direction": "input",
      "required": false,
      "description": "数据输入：compareValue"
    },
    {
      "name": "target",
      "label": "目标组件",
      "type": "string",
      "direction": "output",
      "description": "状态生效的目标组件 ID"
    },
    {
      "name": "state",
      "label": "目标状态",
      "type": "string",
      "direction": "output",
      "description": "生效的状态（visible/disabled/required）"
    }
  ],
  "keywords": [
    "显隐",
    "禁用",
    "必填",
    "条件状态"
  ],
  "inputs": [
    {
      "name": "compareValue",
      "type": "any",
      "required": false,
      "description": "数据输入：compareValue"
    }
  ]
}
