{
  "id": "analytics:game-dashboard",
  "label": "游戏经营看板刷新",
  "description": "按表单筛选器计算最新核心指标并返回可直接回写的看板字段",
  "category": "高阶 · 分析",
  "kind": "generic",
  "macro": {
    "version": 1,
    "expansion": "runtime-composite",
    "debugMapping": "node-output",
    "snapshot": []
  },
  "properties": [
    {
      "name": "mode",
      "label": "运行模式",
      "type": "enum",
      "default": "analysis",
      "options": [
        {
          "label": "指标分析",
          "value": "analysis"
        },
        {
          "label": "预测",
          "value": "forecast"
        },
        {
          "label": "活动分析",
          "value": "campaign"
        }
      ],
      "enum": [
        "analysis",
        "forecast",
        "campaign"
      ]
    }
  ],
  "ports": [
    {
      "name": "formData",
      "label": "筛选条件",
      "type": "object",
      "direction": "input",
      "required": true,
      "description": "表单数据对象"
    },
    {
      "name": "kpi_dau",
      "label": "DAU",
      "type": "number",
      "direction": "output",
      "description": "日活跃用户数"
    },
    {
      "name": "kpi_mau",
      "label": "MAU",
      "type": "number",
      "direction": "output",
      "description": "月活跃用户数"
    },
    {
      "name": "kpi_d1",
      "label": "D1留存",
      "type": "number",
      "direction": "output",
      "description": "次日留存率"
    },
    {
      "name": "kpi_d7",
      "label": "D7留存",
      "type": "number",
      "direction": "output",
      "description": "7 日留存率"
    },
    {
      "name": "kpi_payment_rate",
      "label": "付费率",
      "type": "number",
      "direction": "output",
      "description": "付费率"
    },
    {
      "name": "kpi_revenue",
      "label": "收入",
      "type": "number",
      "direction": "output",
      "description": "总收入"
    },
    {
      "name": "kpi_arpu",
      "label": "ARPU",
      "type": "number",
      "direction": "output",
      "description": "每用户平均收入"
    },
    {
      "name": "kpi_arppu",
      "label": "ARPPU",
      "type": "number",
      "direction": "output",
      "description": "每付费用户平均收入"
    },
    {
      "name": "dashboard_status",
      "label": "运行状态",
      "type": "string",
      "direction": "output",
      "description": "看板状态"
    },
    {
      "name": "refreshed_rows",
      "label": "刷新行数",
      "type": "number",
      "direction": "output",
      "description": "刷新行数"
    },
    {
      "name": "filters",
      "label": "filters",
      "type": "array",
      "direction": "input",
      "required": false,
      "description": "数据输入：filters"
    }
  ],
  "keywords": [
    "看板刷新",
    "KPI",
    "游戏分析",
    "流程输出回写"
  ],
  "inputs": [
    {
      "name": "filters",
      "type": "array",
      "required": false,
      "description": "数据输入：filters"
    }
  ]
}
