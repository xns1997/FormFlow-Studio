{
  "id": "generic-ai-insight",
  "label": "AI 自动洞察",
  "description": "生成数据洞察并解释异常",
  "category": "通用 · AI",
  "kind": "generic",
  "properties": [
    {
      "name": "provider",
      "label": "模型提供方",
      "type": "enum",
      "enum": [
        "openai",
        "local"
      ],
      "default": "openai"
    },
    {
      "name": "model",
      "label": "模型",
      "type": "string",
      "default": ""
    },
    {
      "name": "includeCross",
      "label": "includeCross",
      "type": "boolean",
      "default": false,
      "description": "配置项：includeCross"
    },
    {
      "name": "maxFeatures",
      "label": "maxFeatures",
      "type": "number",
      "default": 0,
      "description": "配置项：maxFeatures"
    }
  ],
  "ports": [
    {
      "name": "data",
      "label": "数据",
      "type": "json-rows",
      "direction": "input",
      "required": true,
      "description": "透传数据"
    },
    {
      "name": "insight",
      "label": "洞察",
      "type": "string",
      "direction": "output",
      "description": "分析结论"
    }
  ],
  "keywords": [
    "AI",
    "洞察",
    "异常解释",
    "分析"
  ]
}
